# Настройки AI-бота
# Скопируй этот файл как .env и измени значения

# URL Ollama сервера (по умолчанию локальный)
OLLAMA_BASE_URL=http://localhost:11434

# Название AI модели (llama3, mistral, gemma2, phi3 и др.)
MODEL_NAME=llama3

# Название бота (отображается в интерфейсе)
APP_TITLE=Мой AI Бот

# Хост и порт сервера
APP_HOST=0.0.0.0
APP_PORT=8000
